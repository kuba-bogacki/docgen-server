    <properties>
        <org.docx4j.core.version>11.5.14</org.docx4j.core.version>
        <org.docx4j.export.version>11.5.3</org.docx4j.export.version>
        <org.docx4j.jaxb.version>11.5.3</org.docx4j.jaxb.version>
